<?xml version="1.0" encoding="utf-8"?>
<!-- Burnout 3: Takedown (static recompilation) on Android: SDL2's activity
     hosting libmain.so, the game built from the user's own disc
     (docs/android.md). After SDL2's android-project manifest; the split into
     a start activity and the game follows Xerenge's Android build.
     Vulkan 1.3 is asked for as a feature but not required: the Retroid
     Pocket 5's stock driver reports 1.1 and the game then needs a replacement
     driver (docs/android.md, "The GPU driver"). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.xenophobentx.takedawn"
    android:installLocation="auto">

    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x403000" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- Rumble (the pad's, or the device's own motor). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Online play (BO-134, docs/online.md): the game's Xbox Live menus
         talk to a lobby server and to the other players over the network.
         Both are normal permissions, granted at install; nothing is sent
         unless online.mode is on. ACCESS_NETWORK_STATE only reads whether
         the device has a network. CHANGE_WIFI_MULTICAST_STATE lets the
         local-network mode hear another copy's lobby announcement. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Custom music (docs/custom-music.md, "Android"): the player's audio
         files in shared storage (Music, Download, a card) read as plain
         files. Asked for by the game only when the Custom music folder row
         is opened (soundtrack.c), never at start-up. READ_MEDIA_AUDIO is
         Android 13's, the minSdk; READ_EXTERNAL_STORAGE would be the one
         before, should the minSdk ever go lower. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Sharper menu pictures (BO-326, docs/upscale-art.md): a foreground
         service keeps the app's process going while the pictures are made,
         also with the app in the background. Normal permissions, granted at
         install; the service runs only while a run lasts. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- extractNativeLibs: the libraries lie in nativeLibraryDir as files (a
         replacement GPU driver's hooks will have to be loaded from there).
         hasFragileUserData: uninstalling offers to keep the game data.
         allowBackup off: the data is the user's disc, gigabytes of it. -->
    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:hasFragileUserData="true"
        android:isGame="true"
        android:appCategory="game"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true">

        <!-- A game to the system's game services (appCategory above; Game
             Turbo and the like find games that way) and its game modes:
             the system does not lower its resolution or frame rate. -->
        <meta-data android:name="android.game_mode_config"
            android:resource="@xml/game_mode_config" />

        <!-- simpleperf from adb may sample a release build. -->
        <profileable android:shell="true" />

        <!-- Opens first: starts the game when its data is in place, says
             where to put it otherwise. -->
        <activity android:name="io.github.xenophobentx.takedawn.StartActivity"
            android:label="@string/app_name"
            android:screenOrientation="sensorLandscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The first start: the game's data from the player's disc image,
             in a process of its own (the native library is loaded for the
             installer alone). -->
        <activity android:name="io.github.xenophobentx.takedawn.SetupActivity"
            android:label="@string/app_name"
            android:process=":setup"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:exported="true" />

        <!-- Starts the app again after "Restart the game now" (the overlay). -->
        <activity android:name="io.github.xenophobentx.takedawn.RestartActivity"
            android:label="@string/app_name"
            android:process=":restart"
            android:screenOrientation="sensorLandscape"
            android:excludeFromRecents="true"
            android:exported="false" />

        <!-- A second launcher entry: which Vulkan driver the game opens
             (docs/android.md, "The GPU driver"). -->
        <activity android:name="io.github.xenophobentx.takedawn.DriverActivity"
            android:label="@string/driver_name"
            android:screenOrientation="sensorLandscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The notices and licence texts that ship in the APK
             (assets/licenses/), as plain text. -->
        <activity android:name="io.github.xenophobentx.takedawn.LicensesActivity"
            android:label="@string/app_name"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <activity android:name="io.github.xenophobentx.takedawn.GameActivity"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="false" />

        <!-- While the menu pictures are made (UpscaleService): one in the
             game's process, one in the setup page's. -->
        <service android:name="io.github.xenophobentx.takedawn.UpscaleService"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="true"
            android:exported="false" />
        <service android:name="io.github.xenophobentx.takedawn.SetupUpscaleService"
            android:process=":setup"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="true"
            android:exported="false" />

        <!-- The bug report from the start page (docs/running.md, "Reporting
             a bug"), in a process of its own: it loads the game's library
             to write the archive, and a game started afterwards must find
             that library unused. -->
        <activity android:name="io.github.xenophobentx.takedawn.ReportActivity"
            android:label="@string/app_name"
            android:process=":report"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />
    </application>
</manifest>
