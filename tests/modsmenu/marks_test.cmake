# marks_test.cmake - cmake/modsmenu_marks.cmake on made-up generated code:
# MODS is allowed (bo3_modsmenu_gen_marks returns 1) only when every mark it
# needs is called at its va, on a line of its own. No game data.
#   cmake -DWORK=<empty scratch folder> -P tests/modsmenu/marks_test.cmake
cmake_minimum_required(VERSION 3.20)
if(NOT WORK)
    message(FATAL_ERROR "marks_test.cmake: -DWORK= is missing")
endif()
if(NOT SCRIPT)                             # another copy of the script: -DSCRIPT=
    set(SCRIPT "${CMAKE_CURRENT_LIST_DIR}/../../cmake/modsmenu_marks.cmake")
endif()
get_filename_component(_script "${SCRIPT}" ABSOLUTE)
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(_pass 0)
set(_fail 0)

# The four marks as config/patches.json has them, and as tools/recomp writes them.
set(_all "si_items:0x00085222" "si_select:0x000853B4" "mm_flow_sel:0x00069733" "mm_flow_back:0x000696F8")

function(json out)                         # json(<file> name:va ...)
    set(_t "{\n  \"patches\": [\n    { \"va\": \"0x00059BF7\", \"setting\": \"game.speed_units\", \"when\": \"kmh\", \"value\": 2 }")
    foreach(_p ${ARGN})
        string(REPLACE ":" ";" _p "${_p}")
        list(GET _p 0 _n)
        list(GET _p 1 _v)
        if(_v MATCHES "^[0-9]+$")
            string(APPEND _t ",\n    { \"va\": ${_v}, \"kind\": \"mark\", \"name\": \"${_n}\" }")
        else()
            string(APPEND _t ",\n    { \"va\": \"${_v}\", \"kind\": \"mark\", \"name\": \"${_n}\" }")
        endif()
    endforeach()
    file(WRITE "${out}" "${_t}\n  ]\n}\n")
endfunction()

# gen(<folder> <call> ...): recomp_0000.c, and recomp_0001.c with one line a
# call, as tools/recomp writes it: name@va, or //name@va for one in a comment
# (a list argument cannot hold the line itself: it has a ';').
function(gen dir)
    file(MAKE_DIRECTORY "${dir}")
    file(WRITE "${dir}/recomp_0000.c" "void sub_00010000(void)\n{\n    g_eax = 1;\n}\n")
    set(_t "void sub_000696D0(void)\n{\n    g_eax = 0;\r\n")
    foreach(_c ${ARGN})
        set(_pre "")
        if(_c MATCHES "^//(.*)$")
            set(_pre "// ")
            set(_c "${CMAKE_MATCH_1}")
        endif()
        string(REPLACE "@" ";" _c "${_c}")
        list(GET _c 0 _n)
        list(GET _c 1 _v)
        string(APPEND _t "    ${_pre}RECOMP_PATCH_MARK(\"${_n}\"); /* patch ${_v}, mark */\r\n")
    endforeach()
    file(WRITE "${dir}/recomp_0001.c" "${_t}}\n")
endfunction()

set(_c1 si_items@0x00085222)
set(_c2 si_select@0x000853B4)
set(_c3 mm_flow_sel@0x00069733)
set(_c4 mm_flow_back@0x000696F8)

# expect(<case> <want 0|1> <release ON|OFF> <patches.json> <gen folder>)
function(expect what want rel patches dir)
    file(REMOVE "${WORK}/out.c")
    execute_process(COMMAND "${CMAKE_COMMAND}" -DPATCHES=${patches} -DGEN=${dir} -DOUT=${WORK}/out.c
                            -DRELEASE=${rel} -P "${_script}"
                    RESULT_VARIABLE _rc OUTPUT_QUIET ERROR_QUIET)
    set(_got "none")
    if(EXISTS "${WORK}/out.c")
        file(READ "${WORK}/out.c" _o)
        if(_o MATCHES "return 1;")
            set(_got 1)
        elseif(_o MATCHES "return 0;")
            set(_got 0)
        endif()
    endif()
    set(_ok 0)
    if(_got STREQUAL "${want}" AND ((rel AND want STREQUAL "0" AND NOT _rc EQUAL 0) OR (NOT (rel AND want STREQUAL "0") AND _rc EQUAL 0)))
        set(_ok 1)
    endif()
    if(_ok)
        math(EXPR _p "${_pass} + 1")
        set(_pass ${_p} PARENT_SCOPE)
    else()
        math(EXPR _f "${_fail} + 1")
        set(_fail ${_f} PARENT_SCOPE)
        message("FAIL ${what}: want ${want}, got ${_got} (exit ${_rc}): ${_o}")
    endif()
endfunction()

json("${WORK}/all.json" ${_all})
gen("${WORK}/current" "${_c1}" "${_c2}" "${_c3}" "${_c4}")
expect("current generated code" 1 OFF "${WORK}/all.json" "${WORK}/current")
expect("current generated code, release" 1 ON "${WORK}/all.json" "${WORK}/current")

gen("${WORK}/stale" "${_c1}" "${_c2}")
expect("generated before the flow marks (no regen.sh)" 0 OFF "${WORK}/all.json" "${WORK}/stale")
expect("the same, release: stops" 0 ON "${WORK}/all.json" "${WORK}/stale")
gen("${WORK}/no_back" "${_c1}" "${_c2}" "${_c3}")
expect("mm_flow_back missing" 0 OFF "${WORK}/all.json" "${WORK}/no_back")
gen("${WORK}/no_select" "${_c1}" "${_c3}" "${_c4}")
expect("si_select missing" 0 OFF "${WORK}/all.json" "${WORK}/no_select")
gen("${WORK}/moved" "${_c1}" "${_c2}" mm_flow_sel@0x00069734 "${_c4}")
expect("mm_flow_sel at another va" 0 OFF "${WORK}/all.json" "${WORK}/moved")
gen("${WORK}/comment" "${_c1}" "${_c2}" "//${_c3}" "${_c4}")
expect("mm_flow_sel only in a comment" 0 OFF "${WORK}/all.json" "${WORK}/comment")
gen("${WORK}/empty")
file(REMOVE "${WORK}/empty/recomp_0000.c" "${WORK}/empty/recomp_0001.c")
expect("no generated code" 0 OFF "${WORK}/all.json" "${WORK}/empty")

json("${WORK}/b.json" "si_items:0x00085222" "si_select:0x000853B4")
expect("config/patches.json without the flow marks" 0 OFF "${WORK}/b.json" "${WORK}/current")
json("${WORK}/short.json" "si_items:0x85222" "si_select:0x853b4" "mm_flow_sel:0x69733" "mm_flow_back:0X696F8")
expect("vas without leading zeros, either case" 1 OFF "${WORK}/short.json" "${WORK}/current")
json("${WORK}/twice.json" ${_all} "mm_flow_sel:0x00069800")
expect("a mark at two vas, one generated" 0 OFF "${WORK}/twice.json" "${WORK}/current")
json("${WORK}/int.json" "si_items:0x00085222" "si_select:0x000853B4" "mm_flow_sel:431923" "mm_flow_back:0x000696F8")
expect("a va that is not 0x...: refused" 0 OFF "${WORK}/int.json" "${WORK}/current")

message("modsmenu_marks: ${_pass} passed, ${_fail} failed")
file(REMOVE_RECURSE "${WORK}")
if(_fail)
    message(FATAL_ERROR "modsmenu_marks: ${_fail} failed")
endif()
