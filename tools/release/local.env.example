# Copy to tools/release/local.env (git-ignored) and fill in. KEY=VALUE lines,
# no quotes, backslashes as they are; the environment wins over this file.

# The toolkit checkout (default: ../xboxrecomp beside this one)
#XBOXRECOMP_DIR=/path/to/xboxrecomp
# A Python with resvg_py for the icons (else resvg or rsvg-convert on PATH)
#TAKEDAWN_PYTHON=/path/to/venv/bin/python3
# A venv with capstone for regen.sh, linked as .venv when the checkout has none
#TAKEDAWN_REGEN_VENV=/path/to/.venv

# Windows build machine: ssh name, and the one folder the release may use there
# (local: this machine, when build-windows.sh itself runs on Windows in Git Bash)
#TAKEDAWN_WIN_HOST=mypc
#TAKEDAWN_WIN_DIR=C:\Users\me\takedawn-release
# An extracted disc folder or image on it, for --install --check
#TAKEDAWN_WIN_DISC=C:\Users\me\discs\Burnout 3 Takedown

# Linux build machine (podman): ssh name, and the folder under its home
#TAKEDAWN_LINUX_HOST=me@linuxbox
#TAKEDAWN_LINUX_DIR=takedawn-build/release

# A disc image or extracted folder on this machine, for the macOS smoke run
#TAKEDAWN_DISC=/path/to/Burnout 3 - Takedown (USA).iso
# Reference saves with a profile (the scene driver's menu flow needs one)
#TAKEDAWN_REF_SAVES=/path/to/saves
# The shared test-machine lock script, when the machines are shared
#TESTHOST_LOCK=/path/to/testhost-lock.sh

# Android build machine (SDK + NDK), see tools/release/build-android.sh
#TAKEDAWN_ANDROID_HOST=me@linuxbox
#TAKEDAWN_ANDROID_DIR=takedawn-build/android
#TAKEDAWN_ANDROID_ENV=takedawn-build/android/env.sh
